e=\"currentColor\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.5\" d=\"M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4\"></path></svg></div><div><span class=\"block font-sans text-[11px] text-zinc-400 font-bold tracking-[0.15em] uppercase mb-1.5\">Tools</span><h3 class=\"font-sans text-zinc-900 text-[13.5px] font-medium leading-[1.6] mb-2\">LLMs (ChatGPT, Claude)<br>Figma<br>Python<br>JavaScript</h3></div></div></div></div></section>",
    "certifications": "<section class=\"certifications-runway bg-white py-24 md:py-32\" id=\"certifications-runway\"><div class=\"container mx-auto px-6 max-w-[1400px]\"><div data-reading-role=\"qualification-section-header\" class=\"text-center mb-16 lg:mb-24 flex flex-col items-center\"><h2 class=\"font-sans text-zinc-900 text-[28px] md:text-[36px] leading-[1.15] tracking-tight font-medium mb-10\"> Certifications </h2><div class=\"flex flex-wrap justify-center items-center gap-2 md:gap-3 text-sm font-sans font-semibold\" data-reading-role=\"qualification-filters\" id=\"cert-tabs\"><button class=\"cert-tab-btn active bg-zinc-900 text-white px-4 py-2 rounded transition-colors whitespace-nowrap shadow-md\" data-target=\"cert-ai\">AI &amp; Tools</button><button class=\"cert-tab-btn text-zinc-500 hover:text-zinc-900 hover:bg-zinc-200/50 px-4 py-2 rounded transition-colors whitespace-nowrap\" data-target=\"cert-data\">Data &amp; Statistics</button><button class=\"cert-tab-btn text-zinc-500 hover:text-zinc-900 hover:bg-zinc-200/50 px-4 py-2 rounded transition-colors whitespace-nowrap\" data-target=\"cert-psycho\">Psychology</button><button class=\"cert-tab-btn text-zinc-500 hover:text-zinc-900 hover:bg-zinc-200/50 px-4 py-2 rounded transition-colors whitespace-nowrap\" data-target=\"cert-lang\">Languages</button></div></div><div class=\"relative w-full max-w-[1100px] mx-auto \" id=\"cert-panels-wrap\"><div class=\"cert-panel grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-20 items-start w-full transition-opacity duration-[1500ms] opacity-100\" id=\"cert-ai\"><div class=\"lg:col-span-5 flex flex-col items-start text-left\"><h3 class=\"font-sans text-[26px] md:text-[32px] tracking-tight font-medium text-zinc-900 mb-4\"> AI &amp; Tools </h3><p class=\"font-sans text-zinc-600 text-[15px] leading-[1.6] font-light max-w-[400px]\"> With solid foundations in prompt engineering and generative models, you can restyle technical products with endless possibilities. No additional onbo